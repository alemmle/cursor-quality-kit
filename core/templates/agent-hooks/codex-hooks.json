{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$(git rev-parse --show-toplevel)/.ai/bin/agent-hook.sh\" pre-shell --format claude", "timeout": 10 }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$(git rev-parse --show-toplevel)/.ai/bin/agent-hook.sh\" stop --format claude", "timeout": 900 }
        ]
      }
    ]
  }
}
